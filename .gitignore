Thumbs.db

# Keep original raw datasets private from the repository
data/raw/*.csv

# Allow the cleaned deployment dataset
!data/processed/perfumes_clean.csv

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep